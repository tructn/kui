{
  "name": "kui",
  "private": true,
  "license": "MIT",
  "version": "0.1.0-alpha.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare": "lefthook install",
    "package": "tauri build",
    "package:mac": "tauri build --bundles app,dmg",
    "package:win": "tauri build --bundles nsis",
    "test": "bun test src && cd src-tauri && cargo test",
    "test:e2e": "docker compose --profile e2e run --build --rm e2e",
    "lint": "cd src-tauri && cargo fmt --check && cargo clippy --all-targets --locked -- -D warnings",
    "security": "bun audit --ignore=GHSA-vfj7-8cjw-p6xm && bun test src && cd src-tauri && cargo test --lib && cargo audit",
    "kafka:up": "docker compose up -d",
    "kafka:down": "docker compose down"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.2",
    "@tauri-apps/api": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.8.0",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "lefthook": "^2.2.1",
    "shadcn": "^4.21.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
